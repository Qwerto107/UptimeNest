# 与 docker-compose.yml 放在同一运行目录；Compose 自动读取 .env。
# 默认 SQLite 无须创建 .env；数据保存在宿主机 ./data。
UPTIMENEST_DB_TYPE=sqlite
UPTIMENEST_DB_DSN=/app/data/uptimenest.db
# 通过 HTTPS 反向代理对外提供访问时改为 true。
UPTIMENEST_COOKIE_SECURE=false
# 自动生成的加密密钥文件须持久化；更换位置时移动原文件，不要生成新密钥。
UPTIMENEST_SECRET_KEY_FILE=/app/data/secret.key
# 管理员密码首次通过 /admin 设置，不从环境变量读取。
# 直接运行程序时请通过终端设置环境变量，程序不会自动读取此文件。
